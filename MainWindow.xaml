<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LegacySTBXConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LegacySTBXConverter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="StoryCAD Outline Converter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Storyboard x:Name="SlideToPage2">
                <DoubleAnimation Storyboard.TargetName="Page1" 
                                Storyboard.TargetProperty="Opacity"
                                To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="Page2" 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
            
            <Storyboard x:Name="SlideToPage3">
                <DoubleAnimation Storyboard.TargetName="Page2" 
                                Storyboard.TargetProperty="Opacity"
                                To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="Page3" 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
            
            <Storyboard x:Name="SlideBackToPage1">
                <DoubleAnimation Storyboard.TargetName="Page2" 
                                Storyboard.TargetProperty="Opacity"
                                To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="Page1" 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
            
            <Storyboard x:Name="SlideBackToPage2">
                <DoubleAnimation Storyboard.TargetName="Page3" 
                                Storyboard.TargetProperty="Opacity"
                                To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="Page2" 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
        </Grid.Resources>

        <!-- Page 1: Directory Selection -->
        <Grid x:Name="Page1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
            
            <StackPanel Spacing="32" Width="600">
                <TextBlock Text="StoryCAD Outline Converter" 
                          Style="{StaticResource TitleTextBlockStyle}" 
                          HorizontalAlignment="Center"/>
                
                <TextBlock Text="Select a folder containing outline files to update" 
                          Style="{StaticResource BodyTextBlockStyle}" 
                          HorizontalAlignment="Center" Opacity="0.8"/>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBox x:Name="DirectoryTextBox" Width="400" 
                            PlaceholderText="Choose folder..." 
                            Text="" VerticalAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Browse" 
                           Click="BrowseButton_Click" 
                           VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ConvertButton" Content="Check Files" 
                       Click="ConvertButton_Click" 
                       Style="{StaticResource AccentButtonStyle}" 
                       Width="200" Height="40"
                       HorizontalAlignment="Center"
                       IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Page 2: File List and Conversion -->
        <Grid x:Name="Page2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
            
            <StackPanel Spacing="24" Width="700">
                <Grid>
                    <Button x:Name="BackToPage1Button" 
                           Content="← Back" 
                           Click="BackToPage1_Click"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                    
                    <TextBlock Text="Outline Files to Update" 
                              Style="{StaticResource TitleTextBlockStyle}" 
                              HorizontalAlignment="Center"/>
                </Grid>

                <Border BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                       BorderThickness="1" CornerRadius="8" Height="350">
                    <Grid>
                        <ListView x:Name="LegacyFilesList" 
                                 SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" 
                                                  FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" 
                                                  FontFamily="Consolas" FontSize="13"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <TextBlock x:Name="NoLegacyFilesText" 
                                  Text="Great! All your outline files are already up to date"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Opacity="0.6"/>
                    </Grid>
                </Border>

                <Grid>
                    <TextBlock x:Name="FileCountText" 
                              HorizontalAlignment="Left"
                              FontSize="14" Opacity="0.8"/>
                    
                    <Button x:Name="StartConversionButton" 
                           Content="Update All" 
                           Click="StartConversion_Click"
                           Style="{StaticResource AccentButtonStyle}" 
                           Width="150" Height="36"
                           HorizontalAlignment="Right"/>
                </Grid>

                <ProgressBar x:Name="ConversionProgressBar" 
                            Height="2" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Page 3: Completion -->
        <Grid x:Name="Page3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
            
            <StackPanel Spacing="32" Width="500">
                <TextBlock Text="✓" 
                          FontSize="72" 
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                
                <TextBlock Text="All Done!" 
                          Style="{StaticResource TitleTextBlockStyle}" 
                          HorizontalAlignment="Center"/>
                
                <TextBlock x:Name="CompletionSummaryText" 
                          Text="Successfully converted X files"
                          Style="{StaticResource BodyTextBlockStyle}" 
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          Opacity="0.8"/>

                <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="CloseButton" 
                           Content="Close" 
                           Click="Close_Click"
                           Style="{StaticResource AccentButtonStyle}" 
                           Width="200" Height="40"/>
                    
                    <Button x:Name="ConvertMoreButton" 
                           Content="Convert More Files" 
                           Click="ConvertMore_Click"
                           Width="200" Height="40"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>